APP_NAME=be-remote-device
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# JWT Secret (digunakan untuk menandatangani token user login)
JWT_SECRET=supersecretkey_change_in_production

# Master API Key (opsional / kunci darurat superuser)
MASTER_API_KEY=my-super-secret-master-key-12345

# PostgreSQL Database Configuration
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=remote_device_db
DB_SSLMODE=disable
