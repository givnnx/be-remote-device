APP_NAME=be-remote-device
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

# JWT Secret (kunci rahasia untuk menandatangani token user login)
JWT_SECRET=supersecretkey_change_in_production

# Master API Key (opsional / kunci darurat superuser)
MASTER_API_KEY=my-super-secret-master-key-12345

# PostgreSQL Database Configuration
# Catatan di server Docker:
# Jika menggunakan shared_network, ubah DB_HOST menjadi nama container DB Anda (misal: postgres / shared-postgres)
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=remote_device_db
DB_SSLMODE=disable
