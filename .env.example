APP_NAME=be-remote-device
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Admin Authentication (for Dashboard / Login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=supersecretkey_change_in_production

# Master Device API Key (for laptop & smartphone background daemons)
MASTER_API_KEY=my-super-secret-device-api-key-12345

# PostgreSQL Database Configuration
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=remote_device_db
DB_SSLMODE=disable
